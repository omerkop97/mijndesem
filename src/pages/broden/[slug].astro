---
import { Image } from 'astro:assets';
import { render, type CollectionEntry } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Container from '@/components/Container.astro';
import Section from '@/components/Section.astro';
import Heading from '@/components/Heading.astro';
import Button from '@/components/Button.astro';
import BestelMoment from '@/components/BestelMoment.astro';
import BroodKaart from '@/components/BroodKaart.astro';
import ExtrasOverzicht from '@/components/ExtrasOverzicht.astro';
import HeartIcon from '@/components/HeartIcon.astro';
import { getBroden } from '@/lib/catalogus';
import { formatEuro } from '@/lib/prijs';
import { allergeenLabels, sporenMelding } from '@/lib/allergenen';
import { site } from '@/data/site';

export async function getStaticPaths() {
  const broden = await getBroden();
  return broden.map((brood) => ({ params: { slug: brood.id }, props: { brood, broden } }));
}

interface Props {
  brood: CollectionEntry<'broden'>;
  broden: CollectionEntry<'broden'>[];
}
const { brood, broden } = Astro.props;
const { naam, prijs, kort, smaak, ingredienten, allergenen, foto, fotoAlt } = brood.data;
const { Content } = await render(brood);
const anderen = broden.filter((b) => b.id !== brood.id).slice(0, 3);

const productSchema = {
  '@context': 'https://schema.org',
  '@type': 'Product',
  name: naam,
  description: kort,
  brand: { '@type': 'Brand', name: site.name },
  offers: {
    '@type': 'Offer',
    price: (prijs / 100).toFixed(2),
    priceCurrency: 'EUR',
    availability: 'https://schema.org/PreOrder',
    url: new URL(`/broden/${brood.id}`, Astro.site).href,
  },
};
---

<BaseLayout title={naam} description={`${kort} ${formatEuro(prijs)}, ophalen in ${site.city}.`} image={foto}>
  <Container size="breed" class="pt-8 pb-20 md:pt-12 md:pb-28">
    <nav aria-label="Kruimelpad" class="text-notenhout-zacht mb-8 text-sm">
      <a href="/broden" class="hover:text-roest underline-offset-4 hover:underline">Broden</a>
      <span class="mx-2" aria-hidden="true">/</span>
      <span aria-current="page">{naam.replace(' Zuurdesem Brood', '')}</span>
    </nav>

    <div class="grid gap-12 lg:grid-cols-2 lg:gap-16">
      <div data-rijs>
        <Image
          src={foto}
          alt={fotoAlt}
          widths={[480, 720, 960, 1200]}
          sizes="(min-width: 1024px) 40vw, 90vw"
          class="shadow-diep aspect-[4/5] w-full rounded-t-full rounded-b-[var(--radius-kaart)] object-cover"
          loading="eager"
          fetchpriority="high"
        />
      </div>

      <div class="lg:pt-10">
        <p class="font-hand text-roest text-2xl" data-rijs>{smaak.join(' · ')}</p>
        <h1 class="mt-2 text-4xl sm:text-5xl" data-rijs>{naam}</h1>
        <p class="mt-5 text-3xl font-medium tabular-nums" data-rijs>{formatEuro(prijs)}</p>

        <div class="text-notenhout-zacht mt-6 space-y-4 text-lg" data-rijs>
          <Content />
        </div>

        <div class="mt-9 flex flex-wrap gap-3" data-rijs>
          <Button href={`/bestellen?brood=${brood.id}`} size="groot">Bestel dit brood</Button>
          <Button href="#extras" variant="secundair" size="groot">Bekijk de extra's</Button>
        </div>
        <BestelMoment class="mt-6" />

        <dl class="border-notenhout/10 divide-notenhout/10 mt-12 divide-y border-y" data-rijs>
          <div class="grid gap-2 py-5 sm:grid-cols-3">
            <dt class="font-semibold">Ingrediënten</dt>
            <dd class="text-notenhout-zacht sm:col-span-2">
              {ingredienten.join(', ')}. Zonder bakkersgist of toevoegingen.
            </dd>
          </div>
          <div class="grid gap-2 py-5 sm:grid-cols-3">
            <dt class="font-semibold">Allergenen</dt>
            <dd class="text-notenhout-zacht sm:col-span-2">
              <span class="text-notenhout font-medium">{allergenen.map((a) => allergeenLabels[a]).join(', ')}.</span>
              {' '}{sporenMelding}{' '}
              <a href="/allergenen" class="text-roest underline underline-offset-4">Meer info</a>
            </dd>
          </div>
          <div class="grid gap-2 py-5 sm:grid-cols-3">
            <dt class="font-semibold">Ophalen</dt>
            <dd class="text-notenhout-zacht sm:col-span-2">
              In {site.city}, elke dag van de week. Bestel minimaal 3 dagen vooruit.
            </dd>
          </div>
        </dl>
      </div>
    </div>
  </Container>

  <Section tone="blush" id="extras">
    <Heading eyebrow="Maak het jouw brood" title="Extra's voor op of in je brood" align="midden">
      <p>Alle extra's zijn te combineren. De meerprijs komt bovenop de prijs van het brood.</p>
    </Heading>
    <ExtrasOverzicht class="mx-auto mt-12 max-w-4xl" />
  </Section>

  <Section>
    <div class="flex items-center gap-3">
      <HeartIcon class="text-roest size-5" />
      <h2 class="text-3xl">Ook lekker</h2>
    </div>
    <div class="mt-10 grid gap-x-6 gap-y-14 sm:grid-cols-2 lg:grid-cols-3">
      {anderen.map((b) => <BroodKaart brood={b} />)}
    </div>
  </Section>

  <script type="application/ld+json" set:html={JSON.stringify(productSchema)} />
</BaseLayout>
