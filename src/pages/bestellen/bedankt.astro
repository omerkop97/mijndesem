---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Container from '@/components/Container.astro';
import Divider from '@/components/Divider.astro';
import Button from '@/components/Button.astro';
import HeartIcon from '@/components/HeartIcon.astro';
import { site } from '@/data/site';
---

<BaseLayout title="Bedankt voor je bestelling" noindex>
  <Container size="smal" class="py-20 text-center md:py-28">
    <HeartIcon class="text-roest mx-auto size-10 animate-rijzen" />
    <p class="font-hand text-roest mt-6 text-2xl">Dankjewel</p>
    <h1 class="mt-2 text-4xl sm:text-5xl">
      Je bestelling is binnen<span id="bedankt-naam"></span>
    </h1>
    <!-- prettier-ignore -->
    <p class="text-notenhout-zacht mx-auto mt-6 max-w-lg text-lg">
      De starter wordt klaargezet voor jouw brood. Je hoort snel van ons om een ophaaltijd af te
      spreken; daarbij krijg je ook het adres in {site.city}. Betalen doe je bij het ophalen.
    </p>

    <div id="testmodus" class="bg-korst/15 mx-auto mt-8 hidden max-w-lg rounded-xl p-4 text-sm">
      <strong>Testmodus:</strong> lokaal (npm run dev) bestaat Netlify Forms niet, dus deze
      bestelling is niet echt verstuurd. Online werkt het wel.
    </div>

    {site.whatsapp && (
      <div
        id="whatsapp-blok"
        class="border-linnen mx-auto mt-10 hidden max-w-lg rounded-[var(--radius-kaart)] border p-6"
      >
        <p class="font-medium">Vraag of wijziging?</p>
        <p class="text-notenhout-zacht mt-1 text-sm">
          Je bestelling is al binnen. Wil je iets vragen of de ophaaltijd afspreken? App ons gerust.
        </p>
        <a
          id="whatsapp-link"
          href={`https://wa.me/${site.whatsapp}`}
          target="_blank"
          rel="noopener"
          class="mt-4 inline-flex h-11 items-center gap-2 rounded-full bg-[#1f8f4e] px-6 font-medium text-white transition-colors hover:bg-[#187540]"
        >
          <svg class="size-5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2Zm0 18.2c-1.6 0-3.1-.4-4.4-1.2l-.3-.2-3 .8.8-2.9-.2-.3A8.2 8.2 0 1 1 12 20.2Zm4.5-6.1c-.2-.1-1.5-.7-1.7-.8-.2-.1-.4-.1-.6.1l-.8 1c-.1.2-.3.2-.5.1a6.7 6.7 0 0 1-3.3-2.9c-.3-.4.2-.4.7-1.3.1-.2 0-.3 0-.4l-.8-1.8c-.2-.5-.4-.4-.6-.4h-.5a1 1 0 0 0-.7.3 3 3 0 0 0-.9 2.2 5.2 5.2 0 0 0 1.1 2.7 11.8 11.8 0 0 0 4.5 4c1.7.7 2.3.8 3.2.6.5-.1 1.5-.6 1.7-1.2.2-.6.2-1.1.2-1.2-.1-.1-.3-.2-.5-.3Z"></path>
          </svg>
          App ons
        </a>
      </div>
    )}

    <div
      id="samenvatting"
      class="bg-meel-warm mx-auto mt-10 hidden max-w-lg rounded-[var(--radius-kaart)] p-6 text-left sm:p-8"
    >
      <h2 class="font-serif text-xl">Jouw bestelling</h2>
      <pre
        id="samenvatting-tekst"
        class="text-notenhout-zacht mt-4 font-sans text-sm leading-relaxed whitespace-pre-wrap"
      ></pre>
    </div>

    <Divider class="text-roest/60 mt-14" />
    <div class="mt-10 flex flex-wrap justify-center gap-3">
      <Button href="/" variant="secundair">
        Terug naar home
      </Button>
      <Button href="/bestellen">Nog iets bestellen</Button>
    </div>
  </Container>
</BaseLayout>

<script>
  try {
    const ruw = sessionStorage.getItem('mijndesem-laatste-bestelling');
    if (ruw) {
      const b = JSON.parse(ruw);
      const voornaam = String(b.naam ?? '').split(' ')[0];
      if (voornaam) document.getElementById('bedankt-naam')!.textContent = `, ${voornaam}`;
      document.getElementById('testmodus')!.classList.toggle('hidden', !b.testmodus);
      // Alleen het bestelgedeelte tonen, zonder contactgegevens
      const deel = String(b.tekst).split('\n\nTelefoon:')[0].split('\n').slice(2).join('\n');
      document.getElementById('samenvatting-tekst')!.textContent = deel;
      document.getElementById('samenvatting')!.classList.remove('hidden');
      // WhatsApp-knop met een kort openingszinnetje (de bestelling zelf komt al automatisch binnen)
      const wa = document.getElementById('whatsapp-link') as HTMLAnchorElement | null;
      if (wa) {
        const dag = b.ophaaldag
          ? new Intl.DateTimeFormat('nl-NL', {
              weekday: 'long',
              day: 'numeric',
              month: 'long',
              timeZone: 'UTC',
            }).format(new Date(`${b.ophaaldag}T00:00:00Z`))
          : '';
        const zin = `Hoi! Ik heb net besteld op naam van ${b.naam}${dag ? ` voor ${dag}` : ''}. `;
        wa.href += `?text=${encodeURIComponent(zin)}`;
        document.getElementById('whatsapp-blok')!.classList.remove('hidden');
      }
    }
  } catch {}
</script>
