---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PaginaKop from '@/components/PaginaKop.astro';
import Container from '@/components/Container.astro';
import Button from '@/components/Button.astro';
import { site } from '@/data/site';

const kanalen = [
  site.whatsapp && {
    label: 'WhatsApp',
    waarde: 'Stuur een appje',
    href: `https://wa.me/${site.whatsapp}`,
  },
  site.email && { label: 'E-mail', waarde: site.email, href: `mailto:${site.email}` },
  site.instagram && {
    label: 'Instagram',
    waarde: `@${site.instagram}`,
    href: `https://instagram.com/${site.instagram}`,
  },
].filter(Boolean) as { label: string; waarde: string; href: string }[];

const veld =
  'border-notenhout/15 bg-meel focus:border-roest focus:ring-roest/20 mt-1.5 block w-full rounded-xl border px-4 py-3 outline-none focus:ring-4';
---

<BaseLayout
  title="Contact"
  description={`Neem contact op met Mijn Desem, thuisbakkerij in ${site.city}. Via WhatsApp of het contactformulier.`}
>
  <PaginaKop eyebrow="Zeg het maar" titel="Contact">
    <p>Een vraag, een speciaal verzoek of een grote bestelling? Ik hoor graag van je.</p>
  </PaginaKop>

  <Container class="grid gap-12 pb-24 md:grid-cols-2">
    <div class="space-y-8">
      {kanalen.length > 0 && (
        <ul class="space-y-4">
          {kanalen.map((k) => (
            <li>
              <a
                href={k.href}
                class="bg-meel-warm hover:bg-linnen group flex items-center justify-between rounded-[var(--radius-kaart)] p-6 transition-colors"
                target={k.href.startsWith('http') ? '_blank' : undefined}
                rel={k.href.startsWith('http') ? 'noopener' : undefined}
              >
                <span>
                  <span class="text-notenhout-zacht block text-sm">{k.label}</span>
                  <span class="font-serif text-xl">{k.waarde}</span>
                </span>
                <span
                  class="text-roest transition-transform group-hover:translate-x-1"
                  aria-hidden="true"
                >
                  →
                </span>
              </a>
            </li>
          ))}
        </ul>
      )}

      <dl class="border-notenhout/10 divide-notenhout/10 divide-y border-y">
        <div class="flex justify-between gap-4 py-4">
          <dt class="font-semibold">Ophalen</dt>
          <dd class="text-notenhout-zacht text-right">{site.city}, adres in de bevestiging</dd>
        </div>
        <div class="flex justify-between gap-4 py-4">
          <dt class="font-semibold">Bakdagen</dt>
          <dd class="text-notenhout-zacht text-right">Maandag t/m zondag</dd>
        </div>
        <div class="flex justify-between gap-4 py-4">
          <dt class="font-semibold">Bestellen</dt>
          <dd class="text-notenhout-zacht text-right">Minimaal 3 dagen vooruit</dd>
        </div>
      </dl>

      <Button href="/bestellen" size="groot">
        Direct bestellen
      </Button>
    </div>

    <!-- Netlify Forms: werkt zonder JavaScript; na verzenden naar /contact/verzonden -->
    <form
      name="contact"
      method="POST"
      action="/contact/verzonden"
      data-netlify="true"
      netlify-honeypot="botcheck"
      class="bg-meel-warm shadow-zacht space-y-5 rounded-[var(--radius-kaart)] p-6 sm:p-8"
    >
      <input type="hidden" name="form-name" value="contact" />
      <p class="hidden" aria-hidden="true">
        <label>
          Niet invullen <input name="botcheck" tabindex="-1" autocomplete="off" />
        </label>
      </p>
      <h2 class="font-serif text-2xl">Stuur een bericht</h2>
      <label class="block">
        <span class="text-sm font-medium">Naam</span>
        <input name="naam" required autocomplete="name" class={veld} />
      </label>
      <label class="block">
        <span class="text-sm font-medium">E-mailadres</span>
        <input name="email" type="email" required autocomplete="email" class={veld} />
      </label>
      <label class="block">
        <span class="text-sm font-medium">
          Telefoon <span class="text-notenhout-zacht font-normal">(optioneel)</span>
        </span>
        <input name="telefoon" type="tel" autocomplete="tel" class={veld} />
      </label>
      <label class="block">
        <span class="text-sm font-medium">Bericht</span>
        <textarea name="bericht" rows="5" required class={veld}></textarea>
      </label>
      <button
        type="submit"
        class="bg-roest text-meel hover:bg-roest-donker shadow-zacht inline-flex h-12 items-center rounded-full px-7 font-medium transition-colors"
      >
        Versturen
      </button>
    </form>
  </Container>
</BaseLayout>
