---
import { Picture } from 'astro:assets';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Button from '@/components/Button.astro';
import BestelMoment from '@/components/BestelMoment.astro';
import HeartIcon from '@/components/HeartIcon.astro';
import heroFoto from '@/assets/photos/brood-roest-doek-baksteen.jpg';
import starterFoto from '@/assets/photos/starter-in-pot.jpg';
import Section from '@/components/Section.astro';
import Heading from '@/components/Heading.astro';
import BroodMenu from '@/components/BroodMenu.astro';
import Marquee from '@/components/Marquee.astro';
import Stempel from '@/components/Stempel.astro';
import ExtrasOverzicht from '@/components/ExtrasOverzicht.astro';
import ProcesTijdlijn from '@/components/ProcesTijdlijn.astro';
import ZoWerktBestellen from '@/components/ZoWerktBestellen.astro';
import FaqLijst from '@/components/FaqLijst.astro';
import SluitCta from '@/components/SluitCta.astro';
import { getBroden, getFaq, getReviews } from '@/lib/catalogus';
import { bakkerij, website } from '@/lib/schema';
import { getImage } from 'astro:assets';
import { site } from '@/data/site';

const broden = await getBroden();
const faq = await getFaq({ alleenHome: true });
const reviews = await getReviews();
const heroAfbeelding = new URL(
  (await getImage({ src: heroFoto, width: 1200, format: 'jpg' })).src,
  Astro.site,
).href;
const minPrijs = Math.min(...broden.map((b) => b.data.prijs));
const maxPrijs = Math.max(...broden.map((b) => b.data.prijs));

const kerncijfers = [
  { getal: '3', label: 'dagen van starter tot brood' },
  { getal: '5', label: 'soorten brood' },
  { getal: '1', label: 'eigen starter' },
  { getal: '0', label: 'toevoegingen' },
];
const marquee = [
  'Eigen starter',
  'Langzaam gerezen',
  'Met de hand gemaakt',
  '100% natuurlijk',
  `Vers uit ${site.city}`,
];
---

<BaseLayout
  schema={[
    website(Astro.site),
    bakkerij(Astro.site, { afbeelding: heroAfbeelding, prijsVan: minPrijs, prijsTot: maxPrijs }),
  ]}
>
  <!-- Hero: redactioneel, foto tot aan de rand van het scherm -->
  <section class="relative">
    <div class="mx-auto grid max-w-[100rem] lg:min-h-[calc(100svh-5rem)] lg:grid-cols-12">
      <div class="flex flex-col justify-center px-4 pt-8 pb-14 sm:px-6 lg:col-span-6 lg:py-16 lg:pr-6 lg:pl-8 xl:pl-16">
        <p class="label text-roest">Ambachtelijke thuisbakkerij · {site.city}</p>
        <!-- prettier-ignore -->
        <h1 class="mt-6 text-[clamp(2.75rem,6.2vw,6.25rem)] leading-[0.95] font-[450] tracking-[-0.03em]">
          Echt zuurdesem, <em class="text-roest font-normal">langzaam</em> gerezen.
        </h1>
        <p class="text-notenhout-zacht mt-8 max-w-md text-lg">
          Elk brood begint drie dagen voordat je het ophaalt: met mijn eigen starter, bloem, water
          en zout. Meer is er niet nodig.
        </p>

        <div class="mt-9 flex flex-wrap gap-3">
          <Button href="/bestellen" size="groot">
            Stel je brood samen
          </Button>
          <Button href="#broden" size="groot" variant="secundair">
            Bekijk de broden
          </Button>
        </div>
        <BestelMoment class="mt-7" />

        <dl class="border-notenhout/15 mt-12 grid max-w-lg grid-cols-4 gap-4 border-t pt-6">
          {kerncijfers.map((k) => (
            <div>
              <dt class="sr-only">{k.label}</dt>
              <dd>
                <span class="block font-serif text-3xl sm:text-4xl">{k.getal}</span>
                <span class="text-notenhout-zacht mt-1 block text-xs leading-snug sm:text-sm">
                  {k.label}
                </span>
              </dd>
            </div>
          ))}
        </dl>
      </div>

      <div class="relative px-4 sm:px-6 lg:col-span-6 lg:px-0">
        <div class="relative h-[72svh] min-h-[26rem] lg:absolute lg:inset-0 lg:h-auto">
          <Picture
            formats={['avif', 'webp']}
            quality={60}
            src={heroFoto}
            alt="Een vers gebakken zuurdesembrood met een diepe insnijding, gewikkeld in een roestbruine linnen doek voor een gele bakstenen muur"
            widths={[640, 960, 1280, 1600]}
            sizes="(min-width: 1024px) 50vw, 100vw"
            class="size-full object-[50%_62%] rounded-tl-[9rem] rounded-tr-[var(--radius-kaart)] rounded-b-[var(--radius-kaart)] object-cover lg:rounded-tl-[16rem] lg:rounded-tr-none lg:rounded-b-none"
            loading="eager"
            fetchpriority="high"
          />
          <Stempel class="absolute -top-10 right-6 lg:top-[38%] lg:right-auto lg:-left-16" />
        </div>
      </div>
    </div>
  </section>

  <Marquee items={marquee} />

  <!-- Assortiment als menukaart -->
  <Section id="broden">
    <div class="mb-14 flex flex-col justify-between gap-6 md:flex-row md:items-end">
      <Heading eyebrow="Het assortiment" title="Vijf broden, één starter">
        <p class="max-w-xl">
          Van mild en luchtig tot donker en hartig. Elk brood krijgt dezelfde aandacht en dezelfde
          tijd.
        </p>
      </Heading>
      <Button href="/bestellen" class="shrink-0">
        Stel je brood samen
      </Button>
    </div>
    <BroodMenu broden={broden} />
  </Section>

  <!-- Extra's -->
  <Section tone="blush" id="extras">
    <div class="grid gap-12 lg:grid-cols-12 lg:items-center">
      <div class="lg:col-span-4">
        <Heading eyebrow="Naar jouw smaak" title="Alles is te combineren">
          <p>
            Kies één extra of combineer er zoveel als je wilt, op elk brood. Rozijnen en hazelnoten
            samen zijn voordeliger.
          </p>
        </Heading>
      </div>
      <ExtrasOverzicht class="lg:col-span-8" />
    </div>
  </Section>

  <!-- Proces -->
  <Section id="proces">
    <Heading eyebrow="Waarom 3 dagen?" title="Echt brood kost tijd" align="midden">
      <p>
        Geen bakkersgist, geen hulpstoffen, geen haast. Alleen meel, water, zout en een starter die
        elke dag verzorgd wordt.
      </p>
    </Heading>
    <div class="mt-16">
      <ProcesTijdlijn />
    </div>
  </Section>

  <!-- De starter -->
  <Section tone="warm" id="starter">
    <div class="grid items-center gap-12 md:grid-cols-2 md:gap-16">
      <div class="relative mx-auto w-full max-w-md" data-rijs>
        <Picture
          formats={['avif', 'webp']}
          quality={60}
          src={starterFoto}
          alt="De zelfgekweekte zuurdesemstarter, zo actief dat hij over de rand van de glazen pot bruist"
          widths={[400, 640, 900]}
          sizes="(min-width: 768px) 28rem, 90vw"
          class="shadow-diep aspect-[4/5] w-full rounded-[var(--radius-kaart)] object-cover"
        />
        <p class="font-hand bg-meel shadow-zacht absolute -right-2 -bottom-6 rotate-[3deg] rounded-xl px-4 py-2 text-xl sm:-right-8">
          zo blij is hij na het voeden ♡
        </p>
      </div>
      <div>
        <Heading eyebrow="Het hart van elk brood" title="Een starter, helemaal zelf gekweekt">
          <p>
            Alles begint bij de starter: een levend mengsel van meel en water vol natuurlijke gisten
            en melkzuurbacteriën. Deze is vanaf de eerste dag zelf gekweekt en wordt dagelijks
            gevoed en verzorgd.
          </p>
          <p class="mt-4">
            Hij laat het brood rijzen én geeft het die typische, licht frisse smaak, de open kruim
            en een korst die kraakt als je hem aansnijdt. Daar komt geen pakje gist aan te pas.
          </p>
        </Heading>
        <Button href="/ons-verhaal" variant="secundair" class="mt-8">
          Lees het hele verhaal
        </Button>
      </div>
    </div>
  </Section>

  <!-- Reviews (verschijnt zodra er echte reviews zijn) -->
  {reviews.length > 0 && (
    <Section id="reviews">
      <Heading eyebrow="Wat anderen zeggen" title="Met liefde gegeten" align="midden" />
      <ul class="mt-14 grid gap-6 md:grid-cols-3">
        {reviews.map((r) => (
          <li class="bg-meel-warm rounded-[var(--radius-kaart)] p-8" data-rijs>
            <HeartIcon class="text-roest size-5" />
            <blockquote class="mt-4 font-serif text-xl leading-snug">“{r.data.tekst}”</blockquote>
            <p class="text-notenhout-zacht mt-5 text-sm">
              {r.data.naam}
              {r.data.plaats && `, ${r.data.plaats}`}
            </p>
          </li>
        ))}
      </ul>
    </Section>
  )}

  <!-- Zo werkt bestellen -->
  <Section id="bestellen-uitleg" class="border-linnen border-t">
    <Heading eyebrow="Simpel en persoonlijk" title="Zo werkt bestellen" />
    <div class="mt-14">
      <ZoWerktBestellen />
    </div>
  </Section>

  <!-- FAQ -->
  <Section tone="warm" size="smal" id="vragen">
    <Heading eyebrow="Goed om te weten" title="Veelgestelde vragen" align="midden" />
    <FaqLijst items={faq} class="mt-12" />
    <p class="mt-10 text-center">
      <a href="/veelgestelde-vragen" class="text-roest font-medium underline underline-offset-4">
        Alle vragen bekijken
      </a>
    </p>
  </Section>

  <SluitCta />
</BaseLayout>
