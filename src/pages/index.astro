---
// Fase 1: hero als eerste indruk van de look. De overige homepage-secties volgen in fase 3.
import { Image } from 'astro:assets';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Container from '@/components/Container.astro';
import Button from '@/components/Button.astro';
import BestelMoment from '@/components/BestelMoment.astro';
import HeartIcon from '@/components/HeartIcon.astro';
import heroFoto from '@/assets/photos/brood-roest-doek-baksteen.jpg';
import detailFoto from '@/assets/photos/starter-in-pot.jpg';
import { site } from '@/data/site';

const usps = ['Eigen starter', '100% natuurlijk', 'Minstens 24 uur gerezen', 'Met de hand gemaakt'];
---

<BaseLayout>
  <section class="relative overflow-hidden pt-6 pb-20 md:pt-10 md:pb-28">
    <Container size="breed" class="grid items-center gap-14 lg:grid-cols-12 lg:gap-10">
      <div class="lg:col-span-6 xl:col-span-5">
        <p class="font-hand text-roest text-2xl" data-rijs>Vers gebakken in {site.city}</p>
        <h1
          class="mt-3 text-[2.6rem] leading-[1.05] sm:text-6xl lg:text-[4.25rem]"
          style="font-variation-settings: 'SOFT' 100;"
          data-rijs
        >
          Echt zuurdesembrood. <em class="text-roest font-normal">Langzaam</em> gerezen.
        </h1>
        <p class="text-notenhout-zacht mt-6 max-w-lg text-lg" data-rijs>
          Elk brood begint drie dagen voordat je het ophaalt: met mijn eigen starter, bloem, water
          en zout. Meer is er niet nodig.
        </p>

        <div class="mt-9 flex flex-wrap gap-3" data-rijs>
          <Button href="/bestellen" size="groot">Stel je brood samen</Button>
          <Button href="/broden" size="groot" variant="secundair">Bekijk de broden</Button>
        </div>

        <BestelMoment class="mt-8" />
      </div>

      <div class="relative lg:col-span-6 xl:col-span-7">
        <div
          class="bg-blush-zacht absolute -top-10 -right-24 -z-10 size-[28rem] rounded-full blur-3xl sm:size-[36rem]"
          aria-hidden="true"
        >
        </div>
        <div class="relative mx-auto max-w-md lg:ml-auto lg:max-w-[30rem]" data-rijs>
          <Image
            src={heroFoto}
            alt="Een vers gebakken zuurdesembrood met een diepe insnijding, gewikkeld in een roestbruine linnen doek voor een gele bakstenen muur"
            widths={[480, 720, 960, 1200]}
            sizes="(min-width: 1024px) 30rem, (min-width: 640px) 28rem, 90vw"
            class="shadow-diep aspect-[4/5] w-full rounded-t-full rounded-b-[var(--radius-kaart)] object-cover"
            loading="eager"
            fetchpriority="high"
          />
          <figure
            class="shadow-diep border-meel absolute -bottom-8 left-3 w-32 rotate-[-4deg] overflow-hidden rounded-2xl border-4 sm:-left-14 sm:w-44"
          >
            <Image
              src={detailFoto}
              alt="De zelfgekweekte zuurdesemstarter, zo actief dat hij over de rand van de pot bruist"
              width={360}
              class="aspect-[3/4] w-full object-cover"
            />
          </figure>
          <p
            class="font-hand text-notenhout absolute -bottom-14 left-32 hidden rotate-[-3deg] text-xl sm:left-36 sm:block"
          >
            ← mijn starter, zelf gekweekt
          </p>
        </div>
      </div>
    </Container>
  </section>

  <div class="border-linnen bg-meel-warm border-y">
    <Container size="breed">
      <ul
        class="grid grid-cols-2 gap-x-4 gap-y-3 py-5 text-xs font-medium tracking-[0.06em] uppercase sm:flex sm:flex-wrap sm:items-center sm:justify-between sm:gap-x-10 sm:text-sm"
      >
        {
          usps.map((usp) => (
            <li class="flex items-center gap-2.5">
              <HeartIcon class="text-roest size-3.5" />
              {usp}
            </li>
          ))
        }
      </ul>
    </Container>
  </div>
</BaseLayout>
