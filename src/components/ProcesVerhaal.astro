---
// Scrollverhaal "van starter tot brood": op desktop blijft de foto staan en wisselt hij per dag
// terwijl je door de stappen scrolt. Op mobiel heeft elke dag zijn eigen foto.
import { Picture } from 'astro:assets';
import starter from '@/assets/photos/starter-in-pot.jpg';
import deeg from '@/assets/photos/deeg-rijst-onder-doek.jpg';
import brood from '@/assets/photos/hartjesbrood-rijsmand.jpg';

const stappen = [
  {
    dag: 'Dag 1',
    titel: 'De starter wordt wakker',
    tekst:
      'Mijn zelfgekweekte starter krijgt verse bloem en water. Binnen een paar uur bruist hij tot over de rand van de pot: klaar om jouw brood te laten rijzen.',
    foto: starter,
    alt: 'Een bruisende zuurdesemstarter die over de rand van een glazen pot borrelt',
  },
  {
    dag: 'Dag 2',
    titel: 'Kneden, vouwen, wachten',
    tekst:
      'Het deeg wordt met de hand gemaakt en een paar keer gevouwen. Daarna mag het langzaam rijzen. In die rust ontstaat de smaak, de open kruim en de bekende lichte zuurheid.',
    foto: deeg,
    alt: 'Een bol deeg met zaden rijst in een mand, half bedekt met een geborduurde theedoek',
  },
  {
    dag: 'Dag 3',
    titel: 'De oven in, en naar jou',
    tekst:
      'Insnijden, een hartje van bloem en dan de hete oven in. Vers en nog geurend ligt jouw brood klaar om opgehaald te worden.',
    foto: brood,
    alt: 'Een vers gebakken zuurdesembrood met hartjes van bloem op de korst',
  },
];
---

<section id="proces" class="bg-notenhout text-meel relative" data-verhaal>
  <div class="mx-auto max-w-7xl px-4 py-24 sm:px-6 md:py-32 lg:px-8">
    <div class="max-w-2xl">
      <p class="label text-blush">Waarom 3 dagen?</p>
      <h2 class="mt-5 text-4xl sm:text-5xl lg:text-6xl">
        Echt brood <em class="text-blush font-normal">kost tijd</em>
      </h2>
      <p class="text-meel/75 mt-6 text-lg">
        Geen bakkersgist, geen hulpstoffen, geen haast. Alleen meel, water, zout en een starter die
        elke dag verzorgd wordt.
      </p>
    </div>

    <div class="mt-16 grid gap-16 lg:mt-20 lg:grid-cols-12 lg:gap-20">
      <!-- Vaste foto (desktop) -->
      <div class="hidden lg:col-span-5 lg:block">
        <div class="sticky top-28">
          <div class="relative aspect-[4/5] overflow-hidden rounded-t-full rounded-b-[var(--radius-kaart)]">
            {stappen.map((s, i) => (
              <Picture
                formats={['avif', 'webp']}
                quality={60}
                src={s.foto}
                alt={s.alt}
                widths={[480, 720, 960]}
                sizes="(min-width: 1024px) 34vw, 1px"
                data-verhaal-foto={i}
                class:list={[
                  'absolute inset-0 size-full object-cover transition-[opacity,transform] duration-1000 ease-(--ease-zacht)',
                  i === 0 ? 'scale-100 opacity-100' : 'scale-105 opacity-0',
                ]}
              />
            ))}
          </div>
          <!-- Voortgang -->
          <div class="mt-6 flex items-center gap-3" aria-hidden="true">
            {stappen.map((s, i) => (
              <span class="flex flex-1 flex-col gap-2">
                <span class="bg-meel/15 h-0.5 overflow-hidden rounded-full">
                  <span
                    data-verhaal-balk={i}
                    class:list={[
                      'bg-blush block h-full origin-left transition-transform duration-700',
                      i === 0 ? 'scale-x-100' : 'scale-x-0',
                    ]}
                  ></span>
                </span>
                <span class="label text-meel/60">{s.dag}</span>
              </span>
            ))}
          </div>
        </div>
      </div>

      <!-- Stappen -->
      <ol class="space-y-20 lg:col-span-7 lg:space-y-0">
        {stappen.map((s, i) => (
          <li
            data-verhaal-stap={i}
            class="transition-opacity duration-700 lg:flex lg:min-h-[78svh] lg:flex-col lg:justify-center lg:opacity-30 lg:[&.is-actief]:opacity-100"
          >
            <Picture
              formats={['avif', 'webp']}
              quality={60}
              src={s.foto}
              alt={s.alt}
              widths={[480, 720]}
              sizes="(min-width: 1024px) 1px, 90vw"
              class="mb-8 aspect-[4/3] w-full rounded-[var(--radius-kaart)] object-cover lg:hidden"
            />
            <p class="font-hand text-blush text-3xl">{s.dag}</p>
            <h3 class="mt-3 text-3xl sm:text-4xl lg:text-5xl">{s.titel}</h3>
            <p class="text-meel/75 mt-5 max-w-lg text-lg">{s.tekst}</p>
          </li>
        ))}
      </ol>
    </div>
  </div>
</section>

<script>
  document.querySelectorAll<HTMLElement>('[data-verhaal]').forEach((verhaal) => {
    const stappen = verhaal.querySelectorAll<HTMLElement>('[data-verhaal-stap]');
    const fotos = verhaal.querySelectorAll<HTMLElement>('[data-verhaal-foto]');
    const balken = verhaal.querySelectorAll<HTMLElement>('[data-verhaal-balk]');

    const activeer = (n: number) => {
      stappen.forEach((s, i) => s.classList.toggle('is-actief', i === n));
      fotos.forEach((f, i) => {
        f.classList.toggle('opacity-100', i === n);
        f.classList.toggle('scale-100', i === n);
        f.classList.toggle('opacity-0', i !== n);
        f.classList.toggle('scale-105', i !== n);
      });
      balken.forEach((b, i) => {
        b.classList.toggle('scale-x-100', i <= n);
        b.classList.toggle('scale-x-0', i > n);
      });
    };
    activeer(0);

    // De stap die het midden van het scherm passeert wordt actief
    const io = new IntersectionObserver(
      (entries) => {
        for (const e of entries) {
          if (e.isIntersecting) activeer(Number((e.target as HTMLElement).dataset.verhaalStap));
        }
      },
      { rootMargin: '-45% 0px -45% 0px' },
    );
    stappen.forEach((s) => io.observe(s));
  });
</script>
