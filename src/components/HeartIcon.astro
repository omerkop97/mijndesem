---
// Het bloemhartje van de korst: een terugkerend handschrift-detail.
interface Props {
  class?: string;
  label?: string;
}
const { class: className = 'size-4', label } = Astro.props;
---

<svg
  class={className}
  viewBox="0 0 24 24"
  fill="currentColor"
  role={label ? 'img' : undefined}
  aria-label={label}
  aria-hidden={label ? undefined : 'true'}
>
  <path
    d="M12 20.5s-7.2-4.4-9.3-8.8C1.2 8.5 3.1 4.8 6.6 4.8c2.2 0 3.7 1.3 5.4 3.3 1.7-2 3.2-3.3 5.4-3.3 3.5 0 5.4 3.7 3.9 6.9-2.1 4.4-9.3 8.8-9.3 8.8z"
  ></path>
</svg>
