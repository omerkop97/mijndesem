---
// Sectiekop: typografisch label, grote serif titel en optionele intro.
interface Props {
  eyebrow?: string;
  title: string;
  level?: 1 | 2 | 3;
  align?: 'links' | 'midden';
  class?: string;
}
const { eyebrow, title, level = 2, align = 'links', class: className } = Astro.props;
const Tag = `h${level}` as 'h1' | 'h2' | 'h3';
const sizes = {
  1: 'text-4xl sm:text-5xl lg:text-6xl',
  2: 'text-[2.1rem] leading-[1.05] tracking-[-0.02em] sm:text-5xl lg:text-[3.4rem]',
  3: 'text-2xl sm:text-3xl',
};
---

<div class:list={[align === 'midden' && 'mx-auto max-w-2xl text-center', className]}>
  {eyebrow && (
    <p
      class:list={[
        'label text-roest mb-5 flex items-center gap-3',
        align === 'midden' && 'justify-center',
      ]}
      data-rijs
    >
      <span class="bg-roest/50 h-px w-8" aria-hidden="true"></span>
      {eyebrow}
    </p>
  )}
  <Tag class={sizes[level]} data-rijs>
    {title}
  </Tag>
  {Astro.slots.has('default') && (
    <div class="text-notenhout-zacht mt-5 text-lg" data-rijs>
      <slot />
    </div>
  )}
</div>
