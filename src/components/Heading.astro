---
// Sectiekop: handgeschreven bovenregel, serif titel en optionele intro.
interface Props {
  eyebrow?: string;
  title: string;
  level?: 1 | 2 | 3;
  align?: 'links' | 'midden';
  class?: string;
}
const { eyebrow, title, level = 2, align = 'links', class: className } = Astro.props;
const Tag = `h${level}` as 'h1' | 'h2' | 'h3';
const sizes = {
  1: 'text-4xl sm:text-5xl lg:text-6xl',
  2: 'text-3xl sm:text-4xl lg:text-[2.75rem]',
  3: 'text-2xl sm:text-3xl',
};
---

<div class:list={[align === 'midden' && 'mx-auto max-w-2xl text-center', className]}>
  {
    eyebrow && (
      <p class="font-hand text-roest mb-2 text-2xl leading-none" data-rijs>
        {eyebrow}
      </p>
    )
  }
  <Tag class={sizes[level]} data-rijs>{title}</Tag>
  {
    Astro.slots.has('default') && (
      <div class="text-notenhout-zacht mt-5 text-lg" data-rijs>
        <slot />
      </div>
    )
  }
</div>
