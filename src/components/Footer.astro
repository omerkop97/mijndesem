---
import { Image } from 'astro:assets';
import Container from './Container.astro';
import HeartIcon from './HeartIcon.astro';
import woordmerk from '@/assets/brand/woordmerk.png';
import brood from '@/assets/brand/brood-illustratie.png';
import { nav, site } from '@/data/site';

const jaar = new Date().getFullYear();
const juridisch = [
  { href: '/allergenen', label: 'Allergenen' },
  { href: '/privacy', label: 'Privacy' },
  { href: '/voorwaarden', label: 'Voorwaarden' },
];
const kop = 'label text-roest-donker mb-5';
---

<footer class="bg-blush text-notenhout overflow-hidden">
  <Container size="breed" class="pt-16 md:pt-24">
    <div class="grid gap-12 sm:grid-cols-2 lg:grid-cols-12">
      <div class="sm:col-span-2 lg:col-span-4">
        <p class="max-w-xs font-serif text-3xl leading-tight">
          Handgemaakt zuurdesembrood, <em class="text-roest-donker">met liefde</em> gebakken in
          {' ' + site.city}.
        </p>
      </div>

      <div class="lg:col-span-3">
        <h2 class={kop}>Bestellen</h2>
        <ul class="text-notenhout/85 space-y-2.5">
          <li>Minimaal 3 dagen vooruit</li>
          <li>Elke dag, maandag t/m zondag</li>
          <li>Ophalen in {site.city}</li>
          <li>Betalen bij ophalen: Tikkie of contant</li>
        </ul>
      </div>

      <nav aria-label="Footermenu" class="lg:col-span-2">
        <h2 class={kop}>Menu</h2>
        <ul class="space-y-2.5">
          {[{ href: '/bestellen', label: 'Bestellen' }, ...nav].map((item) => (
            <li>
              <a
                href={item.href}
                class="hover:text-roest-donker underline-offset-4 hover:underline"
              >
                {item.label}
              </a>
            </li>
          ))}
        </ul>
      </nav>

      {site.whatsapp && (
        <div class="lg:col-span-3">
          <h2 class={kop}>Contact</h2>
          <a
            href={`https://wa.me/${site.whatsapp}`}
            target="_blank"
            rel="noopener"
            class="bg-meel/60 hover:bg-meel inline-flex items-center gap-2.5 rounded-full py-2.5 pr-5 pl-4 font-medium transition-colors"
          >
            <HeartIcon class="text-roest size-4" />
            App ons via WhatsApp
          </a>
          <p class="text-notenhout/75 mt-3 text-sm">
            Vragen of een grote bestelling? Zeg het maar.
          </p>
        </div>
      )}
    </div>
  </Container>

  <!-- Groot woordmerk als handtekening -->
  <div class="mx-auto mt-16 flex max-w-[100rem] items-end gap-[2vw] px-4 sm:px-6 md:mt-24 lg:px-8">
    <Image
      src={brood}
      alt=""
      width={240}
      densities={[1, 2]}
      quality={70}
      class="w-[13vw] max-w-40 shrink-0 translate-y-[6%] drop-shadow-md"
    />
    <Image
      src={woordmerk}
      alt={site.name}
      widths={[480, 800, 1200]}
      sizes="80vw"
      quality={80}
      class="h-auto w-full max-w-[64rem] opacity-90"
    />
  </div>

  <div class="border-notenhout/15 mt-10 border-t">
    <Container
      size="breed"
      class="text-notenhout/85 flex flex-col items-center justify-between gap-4 py-6 text-sm sm:flex-row"
    >
      <p>
        {`© ${jaar} ${site.name} · ${site.tagline}`}
        {site.kvk && <span> · KvK {site.kvk}</span>}
      </p>
      <ul class="flex gap-5">
        {juridisch.map((item) => (
          <li>
            <a href={item.href} class="hover:text-notenhout underline-offset-4 hover:underline">
              {item.label}
            </a>
          </li>
        ))}
      </ul>
    </Container>
  </div>
</footer>
