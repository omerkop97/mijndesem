---
// Logo: broodillustratie en het originele woordmerk, beide losgeknipt uit het merklogo.
// Kan later vervangen worden door een gevectoriseerde SVG (PLAN.md fase 0.3).
import { Image } from 'astro:assets';
import brood from '@/assets/brand/brood-illustratie.png';
import woordmerk from '@/assets/brand/woordmerk.png';
import { site } from '@/data/site';

interface Props {
  variant?: 'header' | 'groot';
  class?: string;
}
const { variant = 'header', class: className } = Astro.props;
const groot = variant === 'groot';
---

<span
  class:list={[
    'inline-flex items-center',
    groot ? 'flex-col gap-4 text-center' : 'gap-2.5',
    className,
  ]}
>
  <Image
    quality={70}
    src={brood}
    alt=""
    width={groot ? 160 : 44}
    densities={[1, 2]}
    class:list={[groot ? 'w-32 sm:w-40' : 'w-10 sm:w-11', 'h-auto drop-shadow-sm']}
    loading="eager"
  />
  <span class="flex flex-col items-center">
    <Image
      quality={80}
      src={woordmerk}
      alt={site.name}
      width={groot ? 340 : 124}
      densities={[1, 2]}
      class:list={[groot ? 'w-64 sm:w-80' : 'w-28 sm:w-[7.75rem]', 'h-auto']}
      loading="eager"
    />
    {groot && (
      <span class="text-notenhout-zacht mt-4 font-serif text-lg tracking-[0.2em] uppercase">
        {site.tagline}
      </span>
    )}
  </span>
</span>
