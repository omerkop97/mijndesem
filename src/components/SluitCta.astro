---
import { Image } from 'astro:assets';
import Container from './Container.astro';
import Button from './Button.astro';
import BestelMoment from './BestelMoment.astro';
import foto from '@/assets/photos/twee-broden-rijsmand-tuin.jpg';

interface Props {
  titel?: string;
}
const { titel = 'Zin in echt brood?' } = Astro.props;
---

<section class="bg-notenhout text-meel overflow-hidden">
  <Container size="breed" class="grid items-center gap-12 py-20 md:grid-cols-2 md:py-24">
    <div data-rijs>
      <p class="font-hand text-blush text-2xl">Vers voor jou gebakken</p>
      <h2 class="mt-2 text-4xl sm:text-5xl">{titel}</h2>
      <p class="text-meel/75 mt-5 max-w-md text-lg">
        Stel je brood samen en kies je ophaaldag. Drie dagen later ligt het vers voor je klaar.
      </p>
      <div class="mt-8 flex flex-wrap items-center gap-4">
        <Button href="/bestellen" variant="licht" size="groot">Bestel je brood</Button>
      </div>
      <BestelMoment class="text-notenhout mt-6" />
    </div>
    <div class="relative mx-auto w-full max-w-sm md:ml-auto" data-rijs>
      <Image
        src={foto}
        alt="Twee vers gebakken zuurdesembroden in een rieten rijsmand, buiten in de zon"
        widths={[400, 640, 800]}
        sizes="(min-width: 768px) 24rem, 90vw"
        class="aspect-[4/5] w-full rounded-t-full rounded-b-[var(--radius-kaart)] object-cover"
      />
    </div>
  </Container>
</section>
