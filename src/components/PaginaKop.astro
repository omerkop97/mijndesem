---
// Kop voor subpagina's: rustig, gecentreerd, met het ornament eronder.
import Container from './Container.astro';
import Divider from './Divider.astro';

interface Props {
  eyebrow?: string;
  titel: string;
}
const { eyebrow, titel } = Astro.props;
---

<header class="pt-14 pb-14 text-center md:pt-20 md:pb-16">
  <Container size="smal">
    {eyebrow && (
      <p class="label text-roest flex items-center justify-center gap-3">
        <span class="bg-roest/50 h-px w-8" aria-hidden="true"></span>
        {eyebrow}
        <span class="bg-roest/50 h-px w-8" aria-hidden="true"></span>
      </p>
    )}
    <h1 class="mt-6 text-[2.75rem] leading-[1] tracking-[-0.025em] sm:text-6xl lg:text-7xl">
      {titel}
    </h1>
    {Astro.slots.has('default') && (
      <div class="text-notenhout-zacht mx-auto mt-6 max-w-xl text-lg">
        <slot />
      </div>
    )}
    <Divider class="text-roest/60 mt-10" />
  </Container>
</header>
