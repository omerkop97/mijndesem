---
// Ornament geïnspireerd op het borduurwerk van de theedoek, met een hartje in het midden.
interface Props {
  class?: string;
}
const { class: className = 'text-roest/70' } = Astro.props;
const uid = `ornament-${Math.random().toString(36).slice(2, 8)}`;
---

<div class:list={['flex justify-center', className]} aria-hidden="true">
  <svg viewBox="0 0 240 32" class="h-6 w-56 sm:w-64" fill="none" stroke="currentColor">
    <g id={uid} stroke-width="1.2" stroke-linecap="round">
      <path d="M2 16 H66"></path>
      <path d="M66 16 C76 16 80 8 89 8 C95 8 97 13 94 15.5 C91.5 17.5 88.5 15 90.5 12.5"></path>
      <path
        d="M74 16 C77 21 83 24 90 23 C86 20 81 17.5 74 16 Z"
        fill="currentColor"
        stroke="none"
      ></path>
      <path
        d="M58 16 C60 11 65 9 70 10 C67 13 63 15 58 16 Z"
        fill="currentColor"
        stroke="none"
      ></path>
      <circle cx="100" cy="20" r="1.3" fill="currentColor" stroke="none"></circle>
      <circle cx="104" cy="16" r="1.3" fill="currentColor" stroke="none"></circle>
      <circle cx="46" cy="12" r="1.1" fill="currentColor" stroke="none"></circle>
      <circle cx="46" cy="20" r="1.1" fill="currentColor" stroke="none"></circle>
    </g>
    <use href={`#${uid}`} transform="translate(240 0) scale(-1 1)"></use>
    <path
      d="M120 23s-5.4-3.3-7-6.6c-1.1-2.4.3-5.2 2.9-5.2 1.7 0 2.8 1 4.1 2.5 1.3-1.5 2.4-2.5 4.1-2.5 2.6 0 4 2.8 2.9 5.2-1.6 3.3-7 6.6-7 6.6z"
      fill="currentColor"
      stroke="none"
    ></path>
  </svg>
</div>
